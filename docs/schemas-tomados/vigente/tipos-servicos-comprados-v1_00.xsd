            <xsd:element name="ResponsavelRetencao" type="tns:tsResponsavelRetencao" minOccurs="0" maxOccurs="1" />
            <xsd:element name="ItemListaServico" type="tns:tsItemListaServico" minOccurs="1" maxOccurs="1" />
