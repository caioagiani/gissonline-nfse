    <xsd:complexType name="tcIdentificacaoPessoaEmpresa">
        <xsd:sequence>
            <xsd:element name="CpfCnpj" type="tns:tcCpfCnpj" minOccurs="1" maxOccurs="1" />
            <xsd:element name="InscricaoMunicipal" type="tns:tsInscricaoMunicipal" minOccurs="0" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="tcDadosTomador">
        <xsd:sequence>
            <xsd:element name="IdentificacaoTomador" type="tns:tcIdentificacaoPessoaEmpresa" minOccurs="0" maxOccurs="1" />
            <xsd:element name="NifTomador" type="tns:tsNif" minOccurs="0" maxOccurs="1" />
