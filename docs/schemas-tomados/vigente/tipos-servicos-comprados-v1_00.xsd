        <xsd:sequence>
            <xsd:element name="Pedido" type="tns:PedidoCancelamentoNotaComprada" />
            <xsd:element name="DataHora" type="xsd:dateTime" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="PeriodoCompetencia">
        <xsd:sequence>
            <xsd:element name="DataInicial" type="xsd:date" minOccurs="1" maxOccurs="1" />
            <xsd:element name="DataFinal" type="xsd:date" minOccurs="0" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:simpleType name="Uf">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="AC" />
            <xsd:enumeration value="AL" />
            <xsd:enumeration value="AM" />
            <xsd:enumeration value="AP" />
            <xsd:enumeration value="BA" />
            <xsd:enumeration value="CE" />
            <xsd:enumeration value="DF" />
            <xsd:enumeration value="ES" />
            <xsd:enumeration value="GO" />
            <xsd:enumeration value="MA" />
            <xsd:enumeration value="MG" />
            <xsd:enumeration value="MS" />
            <xsd:enumeration value="MT" />
            <xsd:enumeration value="PA" />
            <xsd:enumeration value="PB" />
            <xsd:enumeration value="PE" />
            <xsd:enumeration value="PI" />
            <xsd:enumeration value="PR" />
            <xsd:enumeration value="RJ" />
            <xsd:enumeration value="RN" />
            <xsd:enumeration value="RO" />
            <xsd:enumeration value="RR" />
            <xsd:enumeration value="RS" />
            <xsd:enumeration value="SC" />
            <xsd:enumeration value="SE" />
            <xsd:enumeration value="SP" />
            <xsd:enumeration value="TO" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="ListaLoteNotaServicoComprado">
        <xsd:sequence>
            <xsd:element name="ListaLoteNotaServicoComprado" type="tns:LoteNotaServicoComprado" minOccurs="1" maxOccurs="unbounded" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:simpleType name="tsNumeroLote">
        <xsd:restriction base="xsd:nonNegativeInteger">
            <xsd:totalDigits value="15" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsQuantidadeRps">
        <xsd:restriction base="xsd:int">
            <xsd:totalDigits value="4" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsIdTag">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="255" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="IdentificacaoDeclaracao">
        <xsd:sequence>
            <xsd:element name="Numero" type="tns:tsNumeroRps" minOccurs="1" maxOccurs="1" />
            <xsd:element name="NumeroDeclarado" type="xsd:long" minOccurs="0" maxOccurs="1" />
            <xsd:element name="Serie" type="tns:tsSerieRps" minOccurs="1" maxOccurs="1" />
            <xsd:element name="SerieDeclarada" type="xsd:string" minOccurs="0" maxOccurs="1" />
            <xsd:element name="Tipo" type="tns:tsTipoDeclaracao" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:simpleType name="tsNumeroRps">
        <xsd:restriction base="xsd:nonNegativeInteger">
            <xsd:totalDigits value="15" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsSerieRps">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="5" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsTipoDeclaracao">
        <xsd:annotation>
            <xsd:documentation>Tipo de Declaracao ( 1 - Declaracao de Servico Comprado )</xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="xsd:byte">
            <xsd:pattern value="1" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsValor">
        <xsd:restriction base="xsd:decimal">
            <xsd:totalDigits value="15" />
            <xsd:fractionDigits value="2" fixed="true" />
            <xsd:minInclusive value="0" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsAliquota">
        <xsd:restriction base="xsd:decimal">
            <xsd:totalDigits value="5" />
            <xsd:fractionDigits value="4" />
            <xsd:minInclusive value="0" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsNif">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="40" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsRazaoSocial">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="150" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsCep">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="8" />
            <xsd:whiteSpace value="preserve" />
            <xsd:pattern value="[0-9]{8}" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsCodigoMunicipioIbge">
        <xsd:restriction base="xsd:int">
            <xsd:totalDigits value="7" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsBairro">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="60" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsComplementoEndereco">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="60" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsNumeroEndereco">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="60" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsEndereco">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="255" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="tcEnderecoExterior">
        <xsd:sequence>
            <xsd:element name="CodigoPais" type="tns:tsCodigoPaisIbge" minOccurs="1" maxOccurs="1" />
            <xsd:element name="EnderecoCompletoExterior" type="tns:tsEnderecoCompletoExterior" minOccurs="1" maxOccurs="1" />
            <xsd:element name="CodigoEndPostal" type="xsd:string" minOccurs="1" maxOccurs="1" />
            <xsd:element name="Cidade" type="xsd:string" minOccurs="1" maxOccurs="1" />
            <xsd:element name="EstadoProvRegiao" type="xsd:string" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:simpleType name="tsCodigoPaisIbge">
        <xsd:restriction base="xsd:string">
            <xsd:length value="4" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="tcContato">
        <xsd:sequence>
            <xsd:element name="Telefone" type="tns:tsTelefone" minOccurs="1" maxOccurs="1" />
            <xsd:element name="Email" type="tns:tsEmail" minOccurs="0" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:simpleType name="tsTelefone">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="20" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsEmail">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="80" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsCodigoObra">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="30" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsArt">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="30" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsSituacaoLoteRps">
        <xsd:annotation>
            <xsd:documentation>TSituacao do lote de RPS(
                1 – Não Recebido;
                2 – Não Processado;
                3 – Processado com Erro;
                4 – Processado com Sucesso)
            </xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="xsd:byte">
            <xsd:pattern value="1|2|3|4" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="tcCompNfse">
        <xsd:sequence>
            <xsd:element name="Nfse" type="tns:tcNfse" minOccurs="1" maxOccurs="1" />
            <xsd:element name="NfseCancelamento" type="tns:tcCancelamentoNfse" minOccurs="0" maxOccurs="1" />
            <xsd:element name="NfseSubstituicao" type="tns:tcSubstituicaoNfse" minOccurs="0" maxOccurs="1" />
			<xsd:element name="IBSCBSTotal" type="tns:TCRTCIBSCBS" minOccurs="0" maxOccurs="1">
				<xsd:annotation>
					<xsd:documentation>Grupo de informações geradas pelo sistema GISS referentes ao IBS e à CBS automaticamente na conversao em nfse</xsd:documentation>
					
				</xsd:annotation>
			</xsd:element>						
     		<xsd:element name="ChaveNotaNacional" type="tns:tpChaveNotaNacional" minOccurs="0" maxOccurs="1">
        		<xsd:annotation>
          			<xsd:documentation>chave de acesso da NFSE no ADN</xsd:documentation>
        		</xsd:annotation>
      		</xsd:element>		                         
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="tcNfse">
        <xsd:sequence>
            <xsd:element name="InfNfse" type="tns:tcInfNfse" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
        <xsd:attribute name="versao" type="tns:tsVersao" use="required" />
    </xsd:complexType>

    <xsd:complexType name="tcInfNfse">
        <xsd:sequence>
            <xsd:element name="TipoDeclaracaoNota" type="tns:tsTipoDeclaracaoNota" minOccurs="0" maxOccurs="1" />
            <xsd:element name="Numero" type="tns:tsNumeroNfse" minOccurs="1" maxOccurs="1" />
            <xsd:element name="CodigoVerificacao" type="tns:tsCodigoVerificacao" minOccurs="1" maxOccurs="1" />
            <xsd:element name="DataEmissao" type="xsd:dateTime" minOccurs="1" maxOccurs="1" />
            <xsd:element name="NfseSubstituida" type="tns:tsNumeroNfse" minOccurs="0" maxOccurs="1" />
            <xsd:element name="OutrasInformacoes" type="tns:tsOutrasInformacoes" minOccurs="0" maxOccurs="1" />
            <xsd:element name="ValoresNfse" type="tns:tcValoresNfse" minOccurs="1" maxOccurs="1" />
            <xsd:element name="DescricaoCodigoTributacaoMunicipio" type="tns:tsDescricaoCodigoTributacaoMunicipio" minOccurs="0" maxOccurs="1" />
            <xsd:element name="ValorCredito" type="tns:tsValor" minOccurs="0" maxOccurs="1" />
            <xsd:element name="PrestadorServico" type="tns:tcDadosPrestador" minOccurs="1" maxOccurs="1" />
            <xsd:element name="OrgaoGerador" type="tns:tcIdentificacaoOrgaoGerador" minOccurs="1" maxOccurs="1" />
            <xsd:element name="DeclaracaoPrestacaoServico" type="tns:tcDeclaracaoPrestacaoServico" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
        <xsd:attribute name="Id" type="tns:tsIdTag" />
    </xsd:complexType>

    <xsd:simpleType name="tsNumeroNfse">
        <xsd:restriction base="xsd:nonNegativeInteger">
            <xsd:totalDigits value="15" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsTipoDeclaracaoNota">
        <xsd:annotation>
            <xsd:documentation>
                2 - Declaracao com documento
               10 - Declaracao sem documento fiscal
            </xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="xsd:nonNegativeInteger">
            <xsd:pattern value="2|10" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsCodigoVerificacao">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="9" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
            <xsd:pattern value="[a-zA-Z0-9]{1,9}" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsOutrasInformacoes">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="510" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="tcValoresNfse">
        <xsd:sequence>
            <xsd:element name="BaseCalculo" type="tns:tsValor" minOccurs="1" maxOccurs="1" />
            <xsd:element name="Aliquota" type="tns:tsAliquota" minOccurs="0" maxOccurs="1" />
            <xsd:element name="ValorIss" type="tns:tsValor" minOccurs="0" maxOccurs="1" />
            <xsd:element name="ValorLiquidoNfse" type="tns:tsValor" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:simpleType name="tsDescricaoCodigoTributacaoMunicipio">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="1000" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="tcDadosPrestador">
        <xsd:sequence>
            <xsd:element name="RazaoSocial" type="tns:tsRazaoSocial" minOccurs="1" maxOccurs="1" />
            <xsd:element name="NomeFantasia" type="tns:tsNomeFantasia" minOccurs="0" maxOccurs="1" />
            <xsd:element name="Endereco" type="tns:tcEndereco" minOccurs="1" maxOccurs="1" />
            <xsd:element name="Contato" type="tns:tcContato" minOccurs="0" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>


    <xsd:simpleType name="tsNomeFantasia">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="60" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="tcEndereco">
        <xsd:sequence>
            <xsd:element name="Endereco" type="tns:tsEndereco" minOccurs="1" maxOccurs="1" />
            <xsd:element name="Numero" type="tns:tsNumeroEndereco" minOccurs="1" maxOccurs="1" />
            <xsd:element name="Complemento" type="tns:tsComplementoEndereco" minOccurs="0" maxOccurs="1" />
            <xsd:element name="Bairro" type="tns:tsBairro" minOccurs="1" maxOccurs="1" />
            <xsd:element name="CodigoMunicipio" type="tns:tsCodigoMunicipioIbge" minOccurs="1" maxOccurs="1" />
            <xsd:element name="Uf" type="tns:Uf" minOccurs="1" maxOccurs="1" />
            <xsd:element name="Cep" type="tns:tsCep" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>


    <xsd:simpleType name="tsVersao">
        <xsd:restriction base="xsd:token">
            <xsd:pattern value="[1-9]{1}[0-9]{0,1}\.[0-9]{2}" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="tcCancelamentoNfse">
        <xsd:sequence>
            <xsd:element name="Confirmacao" type="tns:tcConfirmacaoCancelamento" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
        <xsd:attribute name="versao" type="tns:tsVersao" use="required" />
    </xsd:complexType>

    <xsd:complexType name="tcConfirmacaoCancelamento">
        <xsd:sequence>
            <xsd:element name="Pedido" type="tns:tcPedidoCancelamento" minOccurs="1" maxOccurs="1" />
            <xsd:element name="DataHora" type="xsd:dateTime" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
        <xsd:attribute name="Id" type="tns:tsIdTag" />
    </xsd:complexType>

    <xsd:complexType name="tcPedidoCancelamento">
        <xsd:sequence>
            <xsd:element name="InfPedidoCancelamento" type="tns:tcInfPedidoCancelamento" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="tcInfPedidoCancelamento">
        <xsd:sequence>
            <xsd:element name="IdentificacaoNfse" type="tns:tcIdentificacaoNfse" minOccurs="1" maxOccurs="1" />
            <xsd:element name="CodigoCancelamento" type="tns:tsCodigoCancelamentoNfse" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
        <xsd:attribute name="Id" type="tns:tsIdTag" />
    </xsd:complexType>

    <xsd:complexType name="tcIdentificacaoNfse">
        <xsd:sequence>
            <xsd:element name="Numero" type="tns:tsNumeroNfse" minOccurs="1" maxOccurs="1" />
            <xsd:element name="CpfCnpj" type="tns:tcCpfCnpj" minOccurs="1" maxOccurs="1" />
            <xsd:element name="InscricaoMunicipal" type="tns:tsInscricaoMunicipal" minOccurs="0" maxOccurs="1" />
            <xsd:element name="CodigoMunicipio" type="tns:tsCodigoMunicipioIbge" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="tcCpfCnpj">
        <xsd:choice>
            <xsd:element name="Cpf" type="tns:tsCpf" minOccurs="1" maxOccurs="1" />
            <xsd:element name="Cnpj" type="tns:tsCnpj" minOccurs="1" maxOccurs="1" />
        </xsd:choice>
    </xsd:complexType>

    <xsd:simpleType name="tsCpf">
        <xsd:restriction base="xsd:string">
            <xsd:length value="11" fixed="true" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsCnpj">
        <xsd:restriction base="xsd:string">
            <xsd:length value="14" fixed="true" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="tcSubstituicaoNfse">
        <xsd:sequence>
            <xsd:element name="SubstituicaoNfse" type="tns:tcInfSubstituicaoNfse" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
        <xsd:attribute name="versao" type="tns:tsVersao" use="required" />
    </xsd:complexType>

    <xsd:complexType name="tcInfSubstituicaoNfse">
        <xsd:sequence>
            <xsd:element name="NfseSubstituidora" type="tns:tsNumeroNfse" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
        <xsd:attribute name="Id" type="tns:tsIdTag" />
    </xsd:complexType>

    <xsd:complexType name="tcIdentificacaoOrgaoGerador">
        <xsd:sequence>
            <xsd:element name="CodigoMunicipio" type="tns:tsCodigoMunicipioIbge" minOccurs="1" maxOccurs="1" />
            <xsd:element name="Uf" type="tns:Uf" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>



    <xsd:complexType name="tcDeclaracaoPrestacaoServico">
        <xsd:sequence>
            <xsd:element name="InfDeclaracaoPrestacaoServico" type="tns:tcInfDeclaracaoPrestacaoServico" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="tcInfDeclaracaoPrestacaoServico">
        <xsd:sequence>
            <xsd:element name="Rps" type="tns:tcInfRps" minOccurs="0" maxOccurs="1" />
            <xsd:element name="Competencia" type="xsd:date" minOccurs="1" maxOccurs="1" />
            <xsd:element name="Servico" type="tns:tcDadosServico" minOccurs="1" maxOccurs="1" />
            <xsd:element name="Prestador" type="tns:tcIdentificacaoPessoaEmpresa" minOccurs="1" maxOccurs="1" />
            <xsd:element name="TomadorServico" type="tns:tcDadosTomador" minOccurs="0" maxOccurs="1" />
            <xsd:element name="Intermediario" type="tns:tcDadosIntermediario" minOccurs="0" maxOccurs="1" />
            <xsd:element name="ConstrucaoCivil" type="tns:tcDadosConstrucaoCivil" minOccurs="0" maxOccurs="1" />
            <xsd:element name="RegimeEspecialTributacao" type="tns:tsRegimeEspecialTributacao" minOccurs="0" maxOccurs="1" />
            <xsd:element name="OptanteSimplesNacional" type="tns:tsSimNao" minOccurs="1" maxOccurs="1" />
            <xsd:element name="IncentivoFiscal" type="tns:tsSimNao" minOccurs="1" maxOccurs="1" />
            <xsd:element name="Evento" type="tns:tcEvento" minOccurs="0" maxOccurs="1" />
            <xsd:element name="InformacoesComplementares" type="tns:tsInformacoesComplementares" minOccurs="0" maxOccurs="1" />
            <xsd:element name="Deducao" type="tns:tcDadosDeducao" minOccurs="0" maxOccurs="unbounded" />
        </xsd:sequence>
        <xsd:attribute name="Id" type="tns:tsIdTag" />
    </xsd:complexType>

    <xsd:complexType name="tcInfRps">
        <xsd:sequence>
            <xsd:element name="IdentificacaoRps" type="tns:tcIdentificacaoRps" minOccurs="0" maxOccurs="1" />
            <xsd:element name="DataEmissao" type="xsd:date" minOccurs="1" maxOccurs="1" />
            <xsd:element name="Status" type="tns:tsStatusRps" minOccurs="1" maxOccurs="1" />
            <xsd:element name="RpsSubstituido" type="tns:tcIdentificacaoRps" minOccurs="0" maxOccurs="1" />
        </xsd:sequence>
        <xsd:attribute name="Id" type="tns:tsIdTag" />
    </xsd:complexType>

    <xsd:complexType name="tcIdentificacaoRps">
        <xsd:sequence>
            <xsd:element name="Numero" type="tns:tsNumeroRps" minOccurs="1" maxOccurs="1" />
            <xsd:element name="Serie" type="tns:tsSerieRps" minOccurs="1" maxOccurs="1" />
            <xsd:element name="Tipo" type="tns:tsTipoRps" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:simpleType name="tsStatusRps">
        <xsd:annotation>
            <xsd:documentation>Situacao do RPS (
                1 - Normal;
                2 - Cancelado)
            </xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="xsd:byte">
            <xsd:pattern value="1|2" />
        </xsd:restriction>
    </xsd:simpleType>


    <xsd:simpleType name="tsTipoRps">
        <xsd:annotation>
            <xsd:documentation>Tipo do RPS (
                1 - RPS;
                2 - RPS Nota Fiscal Conjugada (Mista);
                3 - Cupom)
            </xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="xsd:byte">
            <xsd:pattern value="1|2|3" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsCodigoCancelamentoNfse">
        <xsd:annotation>
            <xsd:documentation>Codigo do Cancelamento da NFS-e (
                1 - Erro na emissao;
                2 - Servico nao prestado;
                3 - Erro de assinatura;
                4 - Duplicidade da nota;
                5 - Erro de processamento)
            </xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="xsd:byte">
            <xsd:pattern value="1|2|3|4|5" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:element name="ListaMensagemAlertaRetorno">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="MensagemRetorno" type="tns:tcMensagemRetorno" minOccurs="1" maxOccurs="unbounded" />
