            <xsd:element name="CodigoTributacaoMunicipio" type="tns:tsCodigoTributacao" minOccurs="0" maxOccurs="1" />
            <xsd:element name="CodigoNbs" type="tns:tsCodigoNbs" minOccurs="1" maxOccurs="1" />
            <xsd:element name="Discriminacao" type="tns:tsDiscriminacao" minOccurs="1" maxOccurs="1" />
            <xsd:element name="CodigoMunicipio" type="tns:tsCodigoMunicipioIbge" minOccurs="1" maxOccurs="1" />
