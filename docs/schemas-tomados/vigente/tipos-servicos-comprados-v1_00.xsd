    <xsd:simpleType name="tsCodigoTributacao">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="20" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>


    <xsd:simpleType name="tsCodigoNbs">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="9" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsDiscriminacao">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="2000" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>


    <xsd:simpleType name="tsExigibilidadeISS">
        <xsd:annotation>
            <xsd:documentation>Exigibilidade do ISS da NFS-e (
                1 - Exigivel;
                2 - Nao incidencia;
                3 - Isencao;
                4 - Exportacao;
                5 - Imunidade;
                6 - Exigibilidade Suspensa por Decisao Judicial;
                7 - Exigibilidade Suspensa por Processo Administrativo)
            </xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="xsd:byte">
            <xsd:pattern value="1|2|3|4|5|6|7" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsIdentifNaoExigibilidade">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="4" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsNumeroProcesso">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="30" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsIdentificacaoEvento">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="30" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="tsDescricaoEvento">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="255" />
            <xsd:minLength value="1" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>


    <xsd:complexType name="tcIdentificacaoDocumentoDeducao">
        <xsd:sequence>
            <xsd:choice>
                <xsd:element name="IdentificacaoNfse" type="tns:tcIdentificacaoNfseDeducao" minOccurs="1" maxOccurs="1" />
                <xsd:element name="IdentificacaoNfe" type="tns:tcIdentificacaoNfeDeducao" minOccurs="1" maxOccurs="1" />
                <xsd:element name="OutroDocumento" type="tns:tcOutroDocumentoDeducao" minOccurs="1" maxOccurs="1" />
            </xsd:choice>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="tcIdentificacaoNfseDeducao">
        <xsd:sequence>
            <xsd:element name="CodigoMunicipioGerador" type="tns:tsCodigoMunicipioIbge" minOccurs="1" maxOccurs="1" />
            <xsd:element name="NumeroNfse" type="tns:tsNumeroNfse" minOccurs="1" maxOccurs="1" />
            <xsd:element name="CodigoVerificacao" type="tns:tsCodigoVerificacao" minOccurs="0" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="tcIdentificacaoNfeDeducao">
        <xsd:sequence>
            <xsd:element name="NumeroNfe" type="tns:tsNumeroNfe" minOccurs="1" maxOccurs="1" />
            <xsd:element name="UfNfe" type="tns:Uf" minOccurs="1" maxOccurs="1" />
            <xsd:element name="ChaveAcessoNfe" type="tns:tsChaveAcessoNfe" minOccurs="0" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>


    <xsd:simpleType name="tsChaveAcessoNfe">
        <xsd:restriction base="xsd:nonNegativeInteger">
            <xsd:totalDigits value="44" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="tcDadosFornecedor">
        <xsd:sequence>
            <xsd:choice>
                <xsd:element name="IdentificacaoFornecedor" type="tns:tcIdentificacaoFornecedor" minOccurs="1" maxOccurs="1" />
                <xsd:element name="FornecedorExterior" type="tns:tcFornecedorExterior" minOccurs="1" maxOccurs="1" />
            </xsd:choice>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="tcIdentificacaoFornecedor">
        <xsd:sequence>
            <xsd:element name="CpfCnpj" type="tns:tcCpfCnpj" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="tcFornecedorExterior">
        <xsd:sequence>
            <xsd:element name="NifFornecedor" type="tns:tsNif" minOccurs="0" maxOccurs="1" />
            <xsd:element name="CodigoPais" type="tns:tsCodigoPaisIbge" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="tcOutroDocumentoDeducao">
        <xsd:sequence>
            <xsd:element name="IdentificacaoDocumento" type="tns:tsIdentificacaoDocumento" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>



