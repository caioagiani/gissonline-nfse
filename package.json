{
  "name": "gissonline-nfse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cliente Node/TypeScript para os Web Services do GissOnline (NFS-e ABRASF 2.04 + LC 214/2025): emissão, cancelamento, substituição, consultas e cadastro de participantes",
  "keywords": [
    "nfse",
    "gissonline",
    "abrasf",
    "nota-fiscal-de-servico",
    "iss",
    "soap",
    "xmldsig",
    "icp-brasil",
    "lc-214-2025"
  ],
  "scripts": {
    "giss": "node --env-file=.env src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "node-forge": "^1.3.1",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/node-forge": "^1.3.14",
    "typescript": "^5.9.2"
  }
}
