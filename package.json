{
  "name": "gissonline-nfse",
  "version": "1.6.0",
  "type": "module",
  "description": "Node/TypeScript client for the GissOnline Web Services (Brazilian municipal service invoices, NFS-e ABRASF 2.04 + LC 214/2025): issuing, cancelling, replacing, queries and the customer directory",
  "keywords": [
    "nfse",
    "gissonline",
    "abrasf",
    "nota-fiscal",
    "iss",
    "soap",
    "xmldsig",
    "icp-brasil",
    "certificado-digital",
    "lc-214-2025",
    "brazil",
    "tax",
    "cli"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/cli/index.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.check.json",
    "giss": "node --env-file-if-exists=.env src/cli/index.ts",
    "prepack": "npm run build",
    "prepare": "husky || true",
    "commitlint": "commitlint --from origin/main --to HEAD",
    "completion:zsh": "node -e \"process.stdout.write(require('node:fs').readFileSync(new URL('completions/_giss', 'file://' + process.cwd() + '/'), 'utf8'))\""
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "node-forge": "^1.3.1",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^24.3.0",
    "@types/node-forge": "^1.3.14",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.2"
  },
  "license": "MIT",
  "author": "Caio Agiani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caioagiani/gissonline-nfse.git"
  },
  "homepage": "https://github.com/caioagiani/gissonline-nfse#readme",
  "bugs": {
    "url": "https://github.com/caioagiani/gissonline-nfse/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "giss": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/schemas",
    "docs/schemas-tomados",
    "completions",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false
}
