# Ambiente: producao | homologacao
GISS_ENV=producao

# Slug do município no host do Web Service (ws-<municipio>.giss.com.br)
GISS_MUNICIPIO=suzano

# Código IBGE do município — também é o subdomínio da API REST do portal
GISS_CODIGO_MUNICIPIO=3552502

# Versão do leiaute ABRASF
GISS_VERSAO=2.04

# Certificado digital A1 (ICP-Brasil). Mantenha fora do controle de versão.
CERT_PATH=cert/certificado.pfx
CERT_PASSWORD=

# Prestador (aceita com ou sem máscara)
GISS_CNPJ=00.000.000/0001-00
GISS_ISC_MUNICIPAL=

# Portal web — usado apenas pela API REST de cadastro (src/portal.ts).
# O Web Service SOAP não precisa destes campos, só do certificado.
GISS_URL=https://suzano.giss.com.br/portal
GISS_LOGIN=
GISS_PASS=
