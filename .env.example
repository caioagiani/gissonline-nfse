# Environment: producao | homologacao
GISS_ENV=producao

# City slug in the Web Service host (ws-<city>.giss.com.br)
GISS_MUNICIPIO=suzano

# City IBGE code — also the subdomain of the portal REST API
GISS_CODIGO_MUNICIPIO=3552502

# ABRASF layout version
GISS_VERSAO=2.04

# A1 digital certificate (ICP-Brasil). Keep it out of version control.
CERT_PATH=cert/certificate.pfx
CERT_PASSWORD=

# Service provider (accepts masked or plain digits)
GISS_CNPJ=00.000.000/0001-00
GISS_ISC_MUNICIPAL=

# Web portal — used only by the REST directory (src/services/portal-service.ts).
# The SOAP Web Service needs none of these, only the certificate.
GISS_URL=https://suzano.giss.com.br/portal
GISS_LOGIN=
GISS_PASS=
